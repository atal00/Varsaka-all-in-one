# ==============================================================================
# VARSAKA REACT (PUBLIC WEBSITE) ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local or set in your deployment platform (e.g. Netlify / Vercel)
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Backend API Base URL
VITE_API_BASE=https://api.varsaka.com

# Supabase Public Configuration (Client-safe anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Lead & Contact Google Sheets / Webhook Sync Target (Optional)
VITE_GS_SYNC_URL=https://script.google.com/macros/s/your-sync-id/exec

# Canonical Production Ecosystem URLs
VITE_SITE_URL=https://varsaka.com
VITE_PORTAL_URL=https://loginto.varsaka.com
VITE_INVOICE_URL=https://invoice.varsaka.com
VITE_BLOG_URL=https://blog.varsaka.com

